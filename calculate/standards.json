  "bridge_barrier_applicability": {
    "standard": "DB11/844-2012 表5",
    "description": "桥梁护栏防撞等级适用条件",
    "conditions": [
      {
        "condition": "桥梁高度小于6m，且桥下水深小于2m或无水",
        "levels": {
          "高速公路(120km/h)": "SB",
          "一级公路(100,80km/h)": "A",
          "二级公路(60km/h)": "A",
          "三四级公路(40-80km/h)": "B"
        }
      },
      {
        "condition": "桥梁高度6-20m，或桥下水深>2m，或跨越一级公路或人流密集区",
        "levels": {
          "高速公路(120km/h)": "SA",
          "一级公路(100,80km/h)": "SB",
          "二级公路(60km/h)": "SB",
          "三四级公路(40-80km/h)": "A"
        }
      },
      {
        "condition": "桥梁高度>20m或跨越高速公路、跨越水库油库电站",
        "levels": {
          "高速公路(120km/h)": "SS",
          "一级公路(100,80km/h)": "SA",
          "二级公路(60km/h)": "SA",
          "三四级公路(40-80km/h)": "SB"
        }
      }
    ],
    "bridge_barrier_types": {
