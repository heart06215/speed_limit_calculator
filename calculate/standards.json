  "barrier_setting_principles": {
    "roadside_barrier": {
      "description": "路侧护栏设置原则(GB 50688-2011 第7.2.3-7.2.5条)",
      "principles": [
        "快速路路侧应设置防撞护栏",
        "主干路路侧应根据具体条件设置防撞护栏",
        "次干路、支路可在危险路段设置防撞护栏",
        "路侧有河流、悬崖等危险地形时必须设置",
        "连续下坡路段应提高护栏等级",
        "小半径平曲线路段应设置或提高护栏等级",
        "车辆越出路外可能产生严重事故的路段必须设置"
      ]
    },
    "median_barrier": {
      "description": "中央分隔带护栏设置原则",
      "principles": [
        "快速路中间带宽度≤12m时必须连续设置防撞护栏",
        "中央分隔带宽度≤10m时必须连续设置中间分隔带护栏",
        "活动护栏防撞等级应与中央分隔带护栏相同",
        "中央分隔带开口处应设置活动护栏"
      ]
    },
    "bridge_barrier": {
      "description": "桥梁护栏设置原则(GB 50688-2011 第7.2.7条)",
      "principles": [
        "快速路桥梁应设置防撞护栏",
        "其他等级桥梁可设防撞护栏或高路缘石",
        "桥梁护栏防护等级应高于路基段",
        "桥梁线形差、大型车辆比例高的路段应提高至少1个防护等级",
        "快速路小桥、涵洞、通道的护栏应与路基段相同"
      ]
    },
    "transition_section": {
      "description": "护栏过渡段设置原则",
      "principles": [
        "结构刚度或防撞等级不同的两种护栏相衔接时应设置过渡段",
        "过渡段应设置于刚度较低或等级较低的护栏范围内",
        "刚度、高度、横断面型式和位置应逐渐过渡",
        "过渡段长度不宜小于10m",
        "波形梁护栏和混凝土护栏衔接处宜采用刚度渐变形式"
      ]
    }
  },
  "barrier_types": {
    "rigid": {
      "name": "刚性护栏",
      "description": "车辆碰撞后基本不变形，主要通过车辆爬高和变形来吸收能量。包括混凝土墙式护栏、钢筋混凝土梁柱式护栏。",
      "advantages": ["防护能力高", "维护成本低", "使用寿命长"],
      "disadvantages": ["对乘员冲击较大", "占地空间大"]
    },
    "semi_rigid": {
      "name": "半刚性护栏",
      "description": "车辆碰撞后有一定变形量。包括波形梁钢护栏。",
      "advantages": ["对乘员冲击较小", "线形诱导性好", "安装方便"],
      "disadvantages": ["防护能力有限", "需要较大变形空间"]
    },
    "combination": {
      "name": "组合式护栏",
      "description": "由两种以上结构形式组合而成，兼具刚性和半刚性特点。",
      "advantages": ["防护能力较强", "适用范围广"],
      "disadvantages": ["构造复杂", "成本较高"]
    }
  },
